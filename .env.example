# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DJANGO_TIME_ZONE=Asia/Kolkata

# Database: "sqlite" (default, zero setup) or "mysql" (MySQL 8+)
DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
DB_NAME=smart_roster
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Needed to create the demo admin when DJANGO_DEBUG is False (seed_data --create-admin)
# DEMO_ADMIN_PASSWORD=
